#!/bin/sh
# init=/init4.sh на p3 карты (sd-stage4.img): rootfs OpenIPC + этот скрипт + /wpa.conf + /shadow4. 28.09.2026.
# Цель: Wi-Fi (MT7601U) + SSH (dropbear, пароль root) прямо с карты, БЕЗ записи в NOR; потом эксперимент
# с приёмом по UART (окна A..E, Pi шлёт строки по маркерам, см. uart/win4.sh). Скрипт НЕ завершается
# (panic=20 в cmdline ядра OpenIPC: выход init = паника = ребут в сток).
# Ничего не пишем в /dev/mtd*: rootfs squashfs ro, /etc — копия в tmpfs через bind-mount.
S() { echo; echo "==== $*"; }
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp; mount -t tmpfs tmpfs /var; mount -t tmpfs tmpfs /run
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
mkdir -p /var/run /var/log /run/lock
S INIT4_START; uname -a; cat /proc/cmdline | sed 's/mtdparts=[^ ]*/mtdparts=.../'
# /etc в tmpfs: пароль root, shell, ключи dropbear (rootfs ro, NOR не трогаем)
mkdir /tmp/etc && cp -a /etc/. /tmp/etc/ && mount --bind /tmp/etc /etc
cp /shadow4 /etc/shadow && chmod 600 /etc/shadow
sed -i 's#^root:.*#root:x:0:0:root:/root:/bin/sh#' /etc/passwd
mkdir -p /etc/dropbear; hostname mjsxj05cm-sd
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
S mtd; cat /proc/mtd
S WIFI; /etc/wireless/usb mt7601u-ssc325-chuangmi-ipc017; echo "usb rc=$?"   # gpio 14 -> 1, modprobe mt7601sta
n=0; while [ $n -lt 40 ] && [ ! -d /sys/class/net/wlan0 ]; do sleep 1; n=$((n+1)); done; echo "wlan0 появился через ${n}s"
ip link set wlan0 up; sleep 1
ip link show wlan0 2>&1
wpa_supplicant -B -i wlan0 -D nl80211,wext -c /wpa.conf; echo "wpa rc=$?"
udhcpc -i wlan0 -b -t 30 -T 3 -s /usr/share/udhcpc/default.script -x hostname:mjsxj05cm-sd; echo "udhcpc rc=$?"
n=0; while [ $n -lt 60 ] && ! ip -4 addr show wlan0 | grep -q inet; do sleep 1; n=$((n+1)); done
S WIFI_RESULT; ip -4 addr show wlan0; ip route; wpa_cli -i wlan0 status 2>&1 | grep -E 'ssid|state|ip_address|bssid'
S SSH; dropbear -R -p 22 -K 300; echo "dropbear rc=$?"; sleep 2; pidof dropbear
S SSH_READY_ip; ip -4 addr show wlan0 | sed -n 's/.*inet \([0-9.]*\).*/\1/p'
# ---------- эксперимент RX по UART (stdin init = /dev/console). Не слать '11111'/'22222' (магия драйвера) ----------
ms() { cat /proc/tty/driver/ms_uart; }
lsr() { printf 'LSR=%s IER=%s IIR=%s ' "$(devmem 0x1f221028 16)" "$(devmem 0x1f221008 16)" "$(devmem 0x1f221010 16)"; echo; }
win() { # $1 имя окна, $2 секунд: сначала вычитать буфер tty (что накопилось), потом ждать одну свежую строку
  x=""; while read -t 2 x; do echo "WIN_${1}_BUFFERED [$x]"; done
  S "WIN_${1}_START ${2}s"; ms; lsr
  l=""; read -t "$2" l; rc=$?; echo; echo "WIN_${1}_GOT rc=$rc [$l]"; ms; lsr; S "WIN_${1}_END"
}
win A 40                                   # база: приём жив после загрузки?
S HEAVY_TX_only; seq 1 12000 | tr '\n' ' ' | fold -w 100; echo   # ~60 КБ, Pi молчит
win B 30                                   # пережил ли приём тяжёлый TX без входа
S HEAVY_TX_with_RX_start; sleep 3          # Pi шлёт строки, пока идёт вывод
seq 20000 32000 | tr '\n' ' ' | fold -w 100; echo
S HEAVY_TX_with_RX_end
win C 30                                   # умер ли приём после входа во время TX
S DRAIN_RBR; i=0; v=$(devmem 0x1f221028 16 2>/dev/null) || v=0
while [ $i -lt 64 ] && [ $(( ${v:-0} & 1 )) -eq 1 ]; do
  printf '%s ' "$(devmem 0x1f221000 16 2>/dev/null)"; i=$((i+1)); v=$(devmem 0x1f221028 16 2>/dev/null) || v=0; done
echo; echo "drained=$i"; lsr
win D 30                                   # ожил ли после вычитки RBR
S CHIPTOP; for a in $(seq 0 4 255); do printf '1f203d%02x=%s ' "$a" "$(devmem $((0x1f203d00+a)) 16)"; done; echo
S INIT4_SHELL_forever
while :; do /bin/sh; sleep 2; done
